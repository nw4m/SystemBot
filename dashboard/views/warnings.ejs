<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Warnings - Bot Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar', { page: 'warnings', username }) %>

  <main class="main-content">

    <div class="page-header">
      <h1>Warnings</h1>
      <p>View and manage member warnings</p>
    </div>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>

    <% const guildIds = Object.keys(warnings); %>

    <% if (guildIds.length === 0) { %>
      <div class="card">
        <div class="card-body empty-state">No warnings have been issued yet.</div>
      </div>
    <% } else { %>

      <% for (const guildId of guildIds) { %>
        <%
          const guildWarns = warnings[guildId];
          const activeUsers = Object.entries(guildWarns).filter(([, w]) => w.length > 0);
        %>
        <% if (activeUsers.length === 0) continue; %>

        <div class="card">
          <div class="card-header">
            Guild: <code><%= guildId %></code>
            <span class="badge-count"><%= activeUsers.length %> users warned</span>
          </div>
          <div class="card-body" style="padding:0; overflow-x:auto">
            <table class="warn-table">
              <thead>
                <tr>
                  <th>User ID</th>
                  <th>Count</th>
                  <th>Last Reason</th>
                  <th>Last By</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% for (const [userId, userWarns] of activeUsers) { %>
                  <% const last = userWarns[userWarns.length - 1]; %>
                  <tr>
                    <td><code><%= userId %></code></td>
                    <td><span class="warn-count"><%= userWarns.length %></span></td>
                    <td><%= last?.reason || 'N/A' %></td>
                    <td><code><%= last?.moderator || 'N/A' %></code></td>
                    <td>
                      <form method="POST" action="/warnings/clear/<%= guildId %>/<%= userId %>"
                            onsubmit="return confirm('Clear all warnings for this user?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-danger btn-sm">Clear</button>
                      </form>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

    <% } %>
  </main>
</div>
</body>
</html>
