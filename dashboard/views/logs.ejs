<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Command Logs - Bot Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar', { page: 'logs', username }) %>

  <main class="main-content">

    <div class="page-header">
      <div class="page-header-row">
        <div>
          <h1>Command Logs</h1>
          <p><%= total %> entries recorded</p>
        </div>
        <form method="POST" action="/logs/clear" onsubmit="return confirm('Clear all logs?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger btn-sm">Clear All Logs</button>
        </form>
      </div>
    </div>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>

    <!-- Filters -->
    <div class="card">
      <div class="card-header">Filters</div>
      <div class="card-body">
        <form method="GET" action="/logs" class="filter-form">
          <div class="filter-row">
            <div class="form-group">
              <label for="f-cmd">Command</label>
              <input type="text" id="f-cmd" name="command" value="<%= filters.command %>" placeholder="e.g. ban" />
            </div>
            <div class="form-group">
              <label for="f-uid">User ID</label>
              <input type="text" id="f-uid" name="userId" value="<%= filters.userId %>" placeholder="Discord user ID" />
            </div>
            <div class="form-group filter-actions">
              <label>&nbsp;</label>
              <div style="display:flex;gap:8px">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a href="/logs" class="btn btn-secondary">Reset</a>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Log Table -->
    <% if (items.length === 0) { %>
      <div class="card">
        <div class="card-body empty-state">No log entries found.</div>
      </div>
    <% } else { %>

    <div class="card">
      <div class="card-header">
        Entries
        <span class="badge-count">Page <%= page %> of <%= pages %></span>
      </div>
      <div class="card-body" style="padding:0; overflow-x:auto">
        <table class="log-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Command</th>
              <th>Used As</th>
              <th>Arguments</th>
              <th>User</th>
              <th>Channel</th>
              <th>Status</th>
              <th>Bot Reply</th>
            </tr>
          </thead>
          <tbody>
            <% for (const log of items) { %>
            <tr class="log-row <%= !log.permitted ? 'row-denied' : (!log.success ? 'row-error' : 'row-ok') %>">

              <td class="log-time">
                <span class="time-date"><%= new Date(log.timestamp).toLocaleDateString('en-GB') %></span>
                <span class="time-hour"><%= new Date(log.timestamp).toLocaleTimeString('en-GB', { hour12: false }) %></span>
              </td>

              <td><code class="cmd-name">!<%= log.command %></code></td>

              <td>
                <% if (log.usedAlias !== log.command) { %>
                  <code class="alias-tag"><%= log.usedAlias %></code>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>

              <td>
                <% if (log.args && log.args.trim()) { %>
                  <span class="log-args"><%= log.args.length > 40 ? log.args.slice(0,40) + '…' : log.args %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>

              <td>
                <div class="log-user">
                  <span class="log-username"><%= log.username %></span>
                  <span class="log-uid"><%= log.userId %></span>
                </div>
              </td>

              <td>
                <div class="log-channel">
                  <span>#<%= log.channelName %></span>
                  <span class="log-uid"><%= log.guildName %></span>
                </div>
              </td>

              <td>
                <% if (!log.permitted) { %>
                  <span class="log-badge denied">Denied</span>
                <% } else if (!log.success) { %>
                  <span class="log-badge error">Error</span>
                  <% if (log.error) { %>
                    <div class="log-error-msg"><%= log.error.slice(0, 60) %></div>
                  <% } %>
                <% } else { %>
                  <span class="log-badge ok">OK</span>
                <% } %>
              </td>

              <td>
                <% if (log.botReply) { %>
                  <span class="log-reply"><%= log.botReply %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>

            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if (pages > 1) { %>
    <div class="pagination">
      <% if (page > 1) { %>
        <a href="/logs?page=<%= page - 1 %>&command=<%= filters.command %>&userId=<%= filters.userId %>" class="btn btn-secondary btn-sm">Previous</a>
      <% } %>

      <% for (let p = Math.max(1, page - 2); p <= Math.min(pages, page + 2); p++) { %>
        <a href="/logs?page=<%= p %>&command=<%= filters.command %>&userId=<%= filters.userId %>"
           class="btn btn-sm <%= p === page ? 'btn-primary' : 'btn-secondary' %>"><%= p %></a>
      <% } %>

      <% if (page < pages) { %>
        <a href="/logs?page=<%= page + 1 %>&command=<%= filters.command %>&userId=<%= filters.userId %>" class="btn btn-secondary btn-sm">Next</a>
      <% } %>
    </div>
    <% } %>

    <% } %>
  </main>
</div>
</body>
</html>
