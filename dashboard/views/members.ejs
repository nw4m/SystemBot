<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Members - Bot Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar', { page: 'members', username }) %>

  <main class="main-content">

    <div class="page-header">
      <div class="page-header-row">
        <div>
          <h1>Moderators</h1>
          <p><%= guildName %> &mdash; <strong><%= modCount %></strong> members with mod permissions &nbsp;/&nbsp; <strong><%= totalMembers %></strong> total</p>
        </div>
        <a href="/members?all=1<%= showAll ? '' : '' %>" class="btn btn-secondary btn-sm">
          <%= showAll ? 'Show Mods Only' : 'Show All Members' %>
        </a>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (!error && members.length === 0) { %>
      <div class="card"><div class="card-body empty-state">No members found.</div></div>
    <% } %>

    <% if (members.length > 0) { %>

    <!-- Search -->
    <div class="card">
      <div class="card-body search-bar-wrap">
        <input type="text" id="memberSearch" placeholder="Search by username..." oninput="filterMembers()" />
        <span class="search-count" id="searchCount"><%= members.length %> shown</span>
      </div>
    </div>

    <!-- Member Cards Grid -->
    <div class="member-grid" id="memberGrid">
      <% for (const m of members) { %>
      <div class="member-card" data-name="<%= m.username.toLowerCase() %>">

        <!-- Card Header -->
        <div class="mc-header">
          <img src="<%= m.avatar %>" class="mc-avatar" alt="" loading="lazy" />
          <div class="mc-identity">
            <div class="mc-name">
              <%= m.username %>
              <% if (m.isAdmin) { %><span class="badge-admin">Admin</span><% } %>
            </div>
            <% if (m.nickname) { %>
              <div class="mc-nick"><%= m.nickname %></div>
            <% } %>
            <div class="mc-id"><%= m.id %></div>
          </div>
        </div>

        <!-- Roles -->
        <div class="mc-section">
          <div class="mc-section-label">Roles</div>
          <div class="roles-wrap">
            <% if (m.roles.length === 0) { %>
              <span class="text-muted">No roles</span>
            <% } else { %>
              <% for (const role of m.roles.slice(0, 5)) { %>
                <span class="role-tag"
                  style="border-color:<%= role.color !== '#000000' ? role.color : '#444' %>;
                         color:<%= role.color !== '#000000' ? role.color : '#888' %>">
                  <%= role.name %>
                </span>
              <% } %>
              <% if (m.roles.length > 5) { %>
                <span class="role-more">+<%= m.roles.length - 5 %></span>
              <% } %>
            <% } %>
          </div>
        </div>

        <!-- Allowed Commands -->
        <div class="mc-section">
          <div class="mc-section-label">
            Allowed Commands
            <span class="mc-cmd-count"><%= m.isAdmin ? 'All' : m.canUse.length %></span>
          </div>
          <% if (m.isAdmin) { %>
            <span class="perm-all">Full access</span>
          <% } else if (m.canUse.length === 0) { %>
            <span class="perm-none">None</span>
          <% } else { %>
            <div class="perms-list">
              <% for (const cmd of m.canUse) { %>
                <span class="perm-tag">!<%= cmd %></span>
              <% } %>
            </div>
          <% } %>
        </div>

      </div>
      <% } %>
    </div>

    <% } %>
  </main>
</div>

<script>
function filterMembers() {
  const q     = document.getElementById('memberSearch').value.toLowerCase();
  const cards = document.querySelectorAll('#memberGrid .member-card');
  let shown   = 0;
  cards.forEach(card => {
    const match = card.dataset.name.includes(q);
    card.style.display = match ? '' : 'none';
    if (match) shown++;
  });
  const el = document.getElementById('searchCount');
  if (el) el.textContent = shown + ' shown';
}
</script>
</body>
</html>
