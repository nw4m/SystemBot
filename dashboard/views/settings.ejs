<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Settings - Bot Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar', { page: 'settings', username }) %>

  <main class="main-content">

    <div class="page-header">
      <h1>Settings</h1>
      <p>Configure prefix, embed color, and command permissions</p>
    </div>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>

    <form method="POST" action="/settings">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="card">
        <div class="card-header">General</div>
        <div class="card-body">
          <div class="form-row">
            <div class="form-group">
              <label for="prefix">Bot Prefix</label>
              <input type="text" id="prefix" name="prefix" value="<%= config.prefix %>" maxlength="5" />
              <small>Character before commands, e.g. !</small>
            </div>
            <div class="form-group">
              <label for="embedColor">Embed Color</label>
              <div class="color-input-wrap">
                <input type="color" id="embedColorPicker" value="<%= config.embedColor %>"
                  oninput="document.getElementById('embedColor').value = this.value" />
                <input type="text" id="embedColor" name="embedColor"
                  value="<%= config.embedColor %>" placeholder="#fd6868" maxlength="7" />
              </div>
              <small>Hex color used in all embeds</small>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          Command Permissions
          <span class="badge-info">Enter Role IDs, one per line or comma-separated. Leave blank = Discord permission fallback.</span>
        </div>
        <div class="card-body">

          <div class="section-label">Moderation</div>
          <div class="perms-grid">
            <% const modCmds = ['ban','unban','kick','mute','unmute','timeout','untimeout','warn','warnings','clearwarnings','nickname','purge','lock','unlock','slowmode']; %>
            <% for (const cmd of modCmds) { %>
              <div class="perm-item">
                <label>!<%= cmd %></label>
                <textarea name="perm_<%= cmd %>" rows="2" placeholder="Role IDs..."><%= (config.permissions[cmd] || []).join('\n') %></textarea>
              </div>
            <% } %>
          </div>

          <div class="section-label" style="margin-top:24px">Utility</div>
          <div class="perms-grid">
            <% const utilCmds = ['channelinfo','roleadd','roleremove','role','ping','help','userinfo','serverinfo','avatar','botinfo','afk','خط']; %>
            <% for (const cmd of utilCmds) { %>
              <div class="perm-item">
                <label>!<%= cmd %></label>
                <textarea name="perm_<%= cmd %>" rows="2" placeholder="Role IDs..."><%= (config.permissions[cmd] || []).join('\n') %></textarea>
              </div>
            <% } %>
          </div>

        </div>
      </div>

      <!-- !خط Command Settings -->
      <div class="card">
        <div class="card-header">!خط — Auto-Response Message</div>
        <div class="card-body">
          <div class="form-group">
            <label for="khatText">Message Text</label>
            <textarea id="khatText" name="khatText" rows="4" placeholder="The message the bot will send when !خط is used..."><%= config.khat?.text || '' %></textarea>
            <small>The bot sends this as a normal message (not a reply) in the same channel.</small>
          </div>
          <div class="form-group">
            <label class="toggle-label">
              <input type="checkbox" name="khatDeleteCmd" id="khatDeleteCmd" <%= config.khat?.deleteCmd ? 'checked' : '' %> />
              <span class="toggle-text">Delete the command message after sending</span>
            </label>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Settings</button>
        <a href="/dashboard" class="btn btn-secondary">Cancel</a>
      </div>

    </form>
  </main>
</div>

<script>
document.getElementById('embedColor').addEventListener('input', function () {
  if (/^#[0-9a-fA-F]{6}$/.test(this.value)) {
    document.getElementById('embedColorPicker').value = this.value;
  }
});
</script>
</body>
</html>
